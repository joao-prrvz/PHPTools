{
    "name": "joao-prrvz/php-tools",
    "type": "library",
    "license": " CC-BY-4.0",
    "autoload": {
        "psr-4": {
            "PHPTools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PHPTools\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Joao Victor Pereira Vaz"
        }
    ],
    "require-dev": {
        "pestphp/pest": "^4.7",
        "phpunit/phpunit": "^12.5"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "require": {
        "nikic/php-parser": "^5.7"
    }
}
